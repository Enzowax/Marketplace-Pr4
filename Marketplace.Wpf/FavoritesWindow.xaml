<Window x:Class="Marketplace.Wpf.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Избранное" Width="700" Height="440" MinWidth="550" MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="Обновить" Click="Refresh_Click" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Перенести в корзину" Click="Move_Click" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Удалить" Click="Remove_Click" Padding="10,4"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <DataGrid x:Name="FavoritesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat=N2}"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}"/>
                <DataGridCheckBoxColumn Header="В продаже" Binding="{Binding CanBuy}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

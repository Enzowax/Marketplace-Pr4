<Window x:Class="Marketplace.Wpf.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина" Width="650" Height="400" MinWidth="540" MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="TotalText" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Margin="0,4,0,8" TextWrapping="Wrap"/>
            <WrapPanel x:Name="Actions" IsEnabled="False">
                <TextBlock x:Name="SelectedName" MaxWidth="180" TextTrimming="CharacterEllipsis"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Label Content="Количество" Target="{Binding ElementName=QuantityBox}"/>
                <TextBox x:Name="QuantityBox" Width="50" Margin="0,0,8,0" MaxLength="10"/>
                <Button Content="Сохранить" Click="Save_Click" Padding="8,3" Margin="0,0,8,0"/>
                <Button x:Name="RemoveButton" Content="Удалить" Click="Remove_Click" Padding="8,3"/>
            </WrapPanel>
        </StackPanel>
        <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" SelectionChanged="Items_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}"/>
                <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat=N2}"/>
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}"/>
                <DataGridCheckBoxColumn Header="Доступен" Binding="{Binding CanBuy}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

<Window x:Class="Marketplace.Wpf.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" Width="460" Height="360" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="Summary" FontSize="18" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <RadioButton x:Name="PickupOption" Content="Самовывоз из ПВЗ" IsChecked="True" Margin="0,0,0,6"/>
        <ComboBox x:Name="PickupBox" DisplayMemberPath="Address" Margin="0,0,0,12"
                  IsEnabled="{Binding IsChecked, ElementName=PickupOption}"/>
        <RadioButton x:Name="DeliveryOption" Content="Доставка по адресу (свыше 600 ₽)" Margin="0,0,0,6"/>
        <TextBox x:Name="AddressBox" MaxLength="512" AutomationProperties.Name="Адрес доставки"
                 IsEnabled="{Binding IsChecked, ElementName=DeliveryOption}" Margin="0,0,0,14"/>
        <Button x:Name="SubmitButton" Content="Оформить заказ" Click="Submit_Click" Padding="10,6"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
</Window>

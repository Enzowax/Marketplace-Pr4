<Window x:Class="Marketplace.Wpf.AdminOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ПВЗ и заказы" Width="900" Height="650" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <Button DockPanel.Dock="Top" Content="Обновить" Click="Refresh_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,10"/>
        <TextBlock DockPanel.Dock="Bottom" x:Name="MessageText" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TabControl>
            <TabItem Header="Заказы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="Order_Selected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Покупатель" Binding="{Binding Login}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding LocalDate, StringFormat='dd.MM.yyyy HH:mm'}"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*"/>
                            <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Margin="0,12">
                        <TextBlock x:Name="DeliveryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <ComboBox x:Name="StatusBox" Width="190" DisplayMemberPath="Name" SelectedValuePath="Code"/>
                            <Button Content="Сохранить статус" Click="SaveStatus_Click" Margin="12,0,0,0" Padding="8,4"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid Grid.Row="2" x:Name="LinesGrid" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}"/>
                            <DataGridTextColumn Header="Цена покупки, ₽" Binding="{Binding Price, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Пункты выдачи">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="Адрес ПВЗ"/>
                        <TextBox x:Name="AddressBox" MaxLength="512" Margin="0,4,0,8"/>
                        <CheckBox x:Name="ActiveBox" Content="Доступен для новых заказов" IsChecked="True" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="Новый ПВЗ" Click="NewPoint_Click" Padding="8,4" Margin="0,0,8,0"/>
                            <Button Content="Сохранить ПВЗ" Click="SavePoint_Click" Padding="8,4"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="PointsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="Point_Selected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Доступен" Binding="{Binding Active, Mode=OneWay}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

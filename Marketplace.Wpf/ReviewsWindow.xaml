<Window x:Class="Marketplace.Wpf.ReviewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отзывы" Width="680" Height="560" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Heading" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="Обновить" Click="Refresh_Click" Padding="8,4"/>
                <Button x:Name="DeleteButton" Content="Удалить отзыв" Click="Delete_Click"
                        Margin="12,0,0,0" Padding="8,4" Visibility="Collapsed"/>
            </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel x:Name="Editor">
                <TextBlock Text="Оценка от 1 до 5"/>
                <ComboBox x:Name="RatingBox" Width="80" HorizontalAlignment="Left" SelectedIndex="4" Margin="0,4,0,8">
                    <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/><ComboBoxItem Content="5"/>
                </ComboBox>
                <TextBox x:Name="CommentBox" MaxLength="4000" Height="75" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Текст отзыва"/>
                <Button Content="Сохранить мой отзыв" Click="Save_Click" HorizontalAlignment="Left" Padding="8,4" Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="ReviewsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Автор" Binding="{Binding Login}" Width="140"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding Rating}" Width="65"/>
                <DataGridTextColumn Header="Отзыв" Binding="{Binding Comment}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

<Window x:Class="Marketplace.Wpf.OrderHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои заказы" Width="850" Height="620" MinWidth="650" MinHeight="450"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <ComboBox x:Name="SortBox" SelectedIndex="0" Width="180">
                <ComboBoxItem Content="Сначала новые"/>
                <ComboBoxItem Content="Сначала старые"/>
            </ComboBox>
            <Button Content="Обновить" Click="Refresh_Click" Margin="12,0" Padding="10,3"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" SelectionChanged="Order_Selected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Заказ №" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding LocalDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*"/>
                    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" x:Name="DeliveryText" Margin="0,12" TextWrapping="Wrap"/>
            <DataGrid Grid.Row="2" x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}"/>
                    <DataGridTextColumn Header="Цена покупки, ₽" Binding="{Binding Price, StringFormat=N2}"/>
                    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
